rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*');
    }

    function validImageSize() {
      return request.resource != null
        && request.resource.size <= 15 * 1024 * 1024;
    }

    match /field-records/{userId}/{recordId}/{fileName} {
      // Todos los usuarios autenticados pueden ver la evidencia fotográfica
      // de todos los registros de la investigación.
      allow read: if isSignedIn();

      // Cada usuario solo puede subir imágenes dentro de su propia carpeta.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isImage()
        && validImageSize();

      // Solo un administrador puede sustituir una evidencia existente.
      allow update: if isAdmin()
        && isImage()
        && validImageSize();

      // Solo un administrador puede eliminar evidencia.
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
